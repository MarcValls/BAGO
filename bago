def _find_tool(stem: str) -> "Path | None":
    """Locate a tool by stem: TOOLS first, then rglob fallback."""
    direct = TOOLS / f"{stem}.py"
    if direct.exists():
        return direct
    hits = list(BAGO_ROOT.rglob(f"{stem}.py"))
    return hits[0] if hits else None


