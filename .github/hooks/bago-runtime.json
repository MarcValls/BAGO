{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/bago_hook.py",
        "powershell": "python .github/hooks/bago_hook.py",
        "cwd": ".",
        "env": {
          "BAGO_COPILOT_HOOK_EVENT": "sessionStart"
        },
        "timeoutSec": 10
      },
      {
        "type": "prompt",
        "prompt": "/agent bago-assistant"
      },
      {
        "type": "prompt",
        "prompt": "Da la bienvenida como bago-assistant. Resume en no mas de cinco lineas el contexto BAGO inyectado al inicio, indica Estado y Siguiente paso, y espera la peticion del usuario. No ejecutes herramientas, no delegues y no inventes trabajo."
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/bago_hook.py",
        "powershell": "python .github/hooks/bago_hook.py",
        "cwd": ".",
        "env": {
          "BAGO_COPILOT_HOOK_EVENT": "postToolUse"
        },
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/bago_hook.py",
        "powershell": "python .github/hooks/bago_hook.py",
        "cwd": ".",
        "env": {
          "BAGO_COPILOT_HOOK_EVENT": "postToolUseFailure"
        },
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/bago_hook.py",
        "powershell": "python .github/hooks/bago_hook.py",
        "cwd": ".",
        "env": {
          "BAGO_COPILOT_HOOK_EVENT": "agentStop"
        },
        "timeoutSec": 10
      }
    ]
  }
}
