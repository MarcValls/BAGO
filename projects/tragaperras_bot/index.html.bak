<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🎰 Casino BAGO</title>
<style>
/* ═══════════════════════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --gold:    #ffd700;
  --gold2:   #ffaa00;
  --red:     #ff2244;
  --green:   #00ff88;
  --blue:    #00aaff;
  --purple:  #cc44ff;
  --dark:    #0a0a0f;
  --panel:   #12121e;
  --chrome:  #2a2a3e;
  --neon-r:  0 0 8px #ff2244, 0 0 20px #ff2244, 0 0 40px #ff224488;
  --neon-g:  0 0 8px #00ff88, 0 0 20px #00ff88, 0 0 40px #00ff8888;
  --neon-y:  0 0 8px #ffd700, 0 0 20px #ffd700, 0 0 40px #ffd70088;
}

html, body {
  width: 100%; height: 100%;
  background: var(--dark);
  color: #fff;
  font-family: 'Segoe UI', system-ui, sans-serif;
  overflow: hidden;
  touch-action: manipulation;
  user-select: none;
}

/* ═══════════════════════════════════════════════════════
   FONDO ANIMADO
═══════════════════════════════════════════════════════ */
#bg-canvas {
  position: fixed; inset: 0;
  pointer-events: none;
  z-index: 0;
}

/* ═══════════════════════════════════════════════════════
   LAYOUT PRINCIPAL
═══════════════════════════════════════════════════════ */
#app {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: flex-start;
  min-height: 100vh; padding: 12px 8px 20px;
  gap: 12px;
}

/* ═══════════════════════════════════════════════════════
   CABECERA / TÍTULO
═══════════════════════════════════════════════════════ */
#header {
  text-align: center;
}
#title {
  font-size: 2.2rem; font-weight: 900;
  letter-spacing: 3px; text-transform: uppercase;
  background: linear-gradient(135deg, var(--gold), var(--gold2), #fff, var(--gold));
  background-size: 200% 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 3s linear infinite;
  filter: drop-shadow(0 0 12px var(--gold2));
}
#subtitle {
  font-size: 0.75rem; letter-spacing: 6px; color: #888; margin-top: 2px;
}
@keyframes shimmer {
  0%{background-position:0 50%} 100%{background-position:200% 50%}
}

/* ═══════════════════════════════════════════════════════
   MÁQUINA TRAGAPERRAS
═══════════════════════════════════════════════════════ */
#machine {
  width: 100%; max-width: 400px;
  background: linear-gradient(180deg, #1a1a2e, #16213e, #0f3460);
  border: 3px solid #333355;
  border-radius: 24px;
  padding: 20px 16px;
  box-shadow:
    0 0 0 1px #ffffff11,
    inset 0 1px 0 #ffffff22,
    0 20px 60px #00000099,
    0 0 80px #0011ff22;
  position: relative;
}

/* Luces LED decorativas */
.led-strip {
  display: flex; justify-content: space-around;
  margin-bottom: 14px;
}
.led {
  width: 10px; height: 10px; border-radius: 50%;
  animation: led-blink 0.8s ease-in-out infinite alternate;
}
.led:nth-child(odd)  { background: var(--red);    box-shadow: var(--neon-r); animation-delay: 0s; }
.led:nth-child(2n)   { background: var(--gold);   box-shadow: var(--neon-y); animation-delay: 0.2s; }
.led:nth-child(3n)   { background: var(--green);  box-shadow: var(--neon-g); animation-delay: 0.4s; }
.led:nth-child(4n+1) { background: var(--blue);   box-shadow: 0 0 8px #00aaff,0 0 20px #00aaff; animation-delay: 0.1s; }
@keyframes led-blink { from{opacity:.3} to{opacity:1} }

/* ═══════════════════════════════════════════════════════
   CARRETES
═══════════════════════════════════════════════════════ */
#reels-container {
  display: flex; gap: 8px;
  background: #05050d;
  border: 2px solid #222244;
  border-radius: 16px;
  padding: 12px;
  position: relative;
  overflow: hidden;
}

/* Línea de pago central */
#reels-container::before {
  content: '';
  position: absolute; left: 0; right: 0;
  top: 50%; transform: translateY(-50%);
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  pointer-events: none;
  z-index: 10;
  animation: payline-pulse 2s ease-in-out infinite;
}
@keyframes payline-pulse {
  0%,100%{opacity:.4} 50%{opacity:1}
}

.reel-wrapper {
  flex: 1;
  height: 100px;
  overflow: hidden;
  border-radius: 10px;
  background: #0a0a1a;
  border: 1px solid #333355;
  position: relative;
}

.reel {
  display: flex; flex-direction: column; align-items: center;
  position: absolute; width: 100%;
  transition: transform 0.05s linear;
}

.reel-cell {
  width: 100%; height: 100px;
  display: flex; align-items: center; justify-content: center;
  font-size: 3rem; line-height: 1;
  flex-shrink: 0;
}

/* Gradiente de fade arriba/abajo del carrete */
.reel-wrapper::before,
.reel-wrapper::after {
  content: ''; position: absolute; left: 0; right: 0; z-index: 5;
  pointer-events: none;
}
.reel-wrapper::before { top: 0; height: 35%;
  background: linear-gradient(to bottom, #05050d, transparent); }
.reel-wrapper::after  { bottom: 0; height: 35%;
  background: linear-gradient(to top, #05050d, transparent); }

/* Flash de victoria en el carrete */
.reel-wrapper.win-flash {
  animation: reel-win-flash 0.6s ease-out;
}
@keyframes reel-win-flash {
  0%  { box-shadow: 0 0 0 0 var(--gold); border-color: var(--gold); }
  50% { box-shadow: 0 0 30px 8px var(--gold); border-color: var(--gold); }
  100%{ box-shadow: none; border-color: #333355; }
}

/* ═══════════════════════════════════════════════════════
   DISPLAY DE RESULTADO
═══════════════════════════════════════════════════════ */
#result-display {
  margin-top: 12px;
  min-height: 48px;
  background: #05050d;
  border: 1px solid #222244;
  border-radius: 10px;
  padding: 8px 14px;
  text-align: center;
  font-size: 0.9rem; font-weight: 600;
  color: #888;
  transition: all 0.3s ease;
  display: flex; align-items: center; justify-content: center;
}
#result-display.win    { color: var(--gold);  text-shadow: var(--neon-y); border-color: var(--gold2); }
#result-display.lose   { color: #666; }
#result-display.near   { color: var(--red);   text-shadow: var(--neon-r); border-color: var(--red); }
#result-display.jackpot{ color: #fff; text-shadow: 0 0 20px #fff, 0 0 40px var(--gold); border-color: var(--gold); }

/* ═══════════════════════════════════════════════════════
   PANEL DE SALDO Y APUESTA
═══════════════════════════════════════════════════════ */
#info-panel {
  display: flex; gap: 8px; width: 100%; max-width: 400px;
}
.info-box {
  flex: 1; background: var(--panel);
  border: 1px solid #222244; border-radius: 12px;
  padding: 10px; text-align: center;
}
.info-label {
  font-size: 0.62rem; letter-spacing: 2px;
  text-transform: uppercase; color: #555; margin-bottom: 4px;
}
.info-value {
  font-size: 1.3rem; font-weight: 800;
  color: var(--gold);
  transition: transform 0.2s, color 0.3s;
}
.info-value.bump {
  animation: bump 0.3s ease-out;
}
@keyframes bump { 0%{transform:scale(1)} 50%{transform:scale(1.3)} 100%{transform:scale(1)} }

/* ═══════════════════════════════════════════════════════
   CONTROL DE APUESTA
═══════════════════════════════════════════════════════ */
#bet-control {
  display: flex; align-items: center; gap: 8px;
  width: 100%; max-width: 400px;
}
.bet-btn {
  width: 44px; height: 44px; border-radius: 50%;
  border: 2px solid #333355;
  background: var(--chrome);
  color: #fff; font-size: 1.4rem; font-weight: 700;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s;
  flex-shrink: 0;
}
.bet-btn:active { transform: scale(0.9); background: #444466; }
#bet-display {
  flex: 1; text-align: center; background: var(--panel);
  border: 1px solid #333355; border-radius: 10px;
  padding: 10px; font-size: 0.75rem; color: #888;
}
#bet-display span {
  display: block; font-size: 1.2rem; font-weight: 800; color: var(--gold2);
}

/* ═══════════════════════════════════════════════════════
   BOTÓN GIRAR
═══════════════════════════════════════════════════════ */
#spin-btn {
  width: 100%; max-width: 400px;
  height: 64px; border-radius: 18px;
  border: none;
  background: linear-gradient(135deg, #cc0022, #ff2244, #ff6600, #ff2244, #cc0022);
  background-size: 200% 200%;
  color: #fff; font-size: 1.4rem; font-weight: 900;
  letter-spacing: 3px; text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 6px 20px #ff224488, inset 0 1px 0 #ffffff33;
  animation: spin-btn-glow 2s ease-in-out infinite alternate;
  transition: transform 0.1s, box-shadow 0.1s;
  position: relative; overflow: hidden;
}
#spin-btn::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, transparent 40%, #ffffff22 50%, transparent 60%);
  background-size: 200% 200%;
  animation: sweep 3s linear infinite;
}
@keyframes sweep { 0%{background-position:-100% 0} 100%{background-position:300% 0} }
@keyframes spin-btn-glow {
  from { box-shadow: 0 6px 20px #ff224488, inset 0 1px 0 #ffffff33; }
  to   { box-shadow: 0 8px 35px #ff2244cc, 0 0 60px #ff224444, inset 0 1px 0 #ffffff33; }
}
#spin-btn:active:not(:disabled) { transform: scale(0.97); }
#spin-btn:disabled {
  background: linear-gradient(135deg, #333, #444, #333);
  box-shadow: none; animation: none; cursor: not-allowed;
}

/* ═══════════════════════════════════════════════════════
   TABLA DE PAGOS (colapsable)
═══════════════════════════════════════════════════════ */
#paytable-toggle {
  font-size: 0.75rem; color: #555; cursor: pointer;
  text-decoration: underline; text-align: center;
  width: 100%; max-width: 400px;
}
#paytable {
  display: none; width: 100%; max-width: 400px;
  background: var(--panel); border: 1px solid #222244;
  border-radius: 12px; padding: 12px;
  font-size: 0.8rem;
}
#paytable.open { display: block; }
.pt-row {
  display: flex; justify-content: space-between;
  padding: 4px 0; border-bottom: 1px solid #1a1a2e;
}
.pt-row:last-child { border: none; }
.pt-mult { color: var(--gold); font-weight: 700; }

/* ═══════════════════════════════════════════════════════
   CANVAS DE PARTÍCULAS (overlay)
═══════════════════════════════════════════════════════ */
#fx-canvas {
  position: fixed; inset: 0;
  pointer-events: none; z-index: 100;
}

/* ═══════════════════════════════════════════════════════
   JACKPOT OVERLAY
═══════════════════════════════════════════════════════ */
#jackpot-overlay {
  display: none;
  position: fixed; inset: 0; z-index: 200;
  background: #000000cc;
  align-items: center; justify-content: center;
  flex-direction: column; gap: 16px;
}
#jackpot-overlay.show { display: flex; }
#jackpot-text {
  font-size: 4rem; font-weight: 900;
  background: linear-gradient(135deg, #fff, var(--gold), #fff);
  background-size: 200% 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 0.5s linear infinite, jackpot-scale 0.3s ease-in-out infinite alternate;
  filter: drop-shadow(0 0 20px var(--gold));
}
@keyframes jackpot-scale { from{transform:scale(1)} to{transform:scale(1.05)} }
#jackpot-win { font-size: 1.5rem; color: var(--gold2); }
#jackpot-close {
  margin-top: 16px; padding: 12px 32px;
  background: var(--gold); color: #000;
  border: none; border-radius: 12px;
  font-size: 1rem; font-weight: 800; cursor: pointer;
}

/* ═══════════════════════════════════════════════════════
   SCREEN SHAKE
═══════════════════════════════════════════════════════ */
@keyframes screen-shake {
  0%,100%{transform:translate(0)} 20%{transform:translate(-6px,3px)}
  40%{transform:translate(6px,-3px)} 60%{transform:translate(-4px,2px)}
  80%{transform:translate(4px,-2px)}
}
body.shake { animation: screen-shake 0.4s ease-out; }

/* ═══════════════════════════════════════════════════════
   WIN FLASH (cuerpo entero)
═══════════════════════════════════════════════════════ */
@keyframes win-pulse {
  0%,100%{background-color:var(--dark)}
  50%{background-color:#1a1200}
}
body.win-bg { animation: win-pulse 0.5s ease-out 2; }

@keyframes jackpot-pulse {
  0%,100%{background-color:var(--dark)}
  50%{background-color:#2a1a00}
}
body.jackpot-bg { animation: jackpot-pulse 0.3s ease-out 6; }

/* ═══════════════════════════════════════════════════════
   ESTADÍSTICAS / RTP
═══════════════════════════════════════════════════════ */
#stats-bar {
  display: flex; gap: 8px; width: 100%; max-width: 400px;
  font-size: 0.65rem; color: #444;
}
.stat { flex: 1; text-align: center; }
.stat-val { color: #666; font-weight: 700; }
</style>
</head>
<body>

<!-- Canvas de fondo (estrellas/partículas ambient) -->
<canvas id="bg-canvas"></canvas>
<!-- Canvas de FX (explosiones, confetti) -->
<canvas id="fx-canvas"></canvas>

<!-- Overlay Jackpot -->
<div id="jackpot-overlay">
  <div id="jackpot-text">🎉 JACKPOT 🎉</div>
  <div id="jackpot-win"></div>
  <button id="jackpot-close">¡COBRAR!</button>
</div>

<div id="app">

  <!-- Título -->
  <div id="header">
    <div id="title">Casino BAGO</div>
    <div id="subtitle">TRAGAPERRAS · VIP</div>
  </div>

  <!-- Máquina -->
  <div id="machine">
    <!-- LEDs decorativos -->
    <div class="led-strip">
      <div class="led"></div><div class="led"></div><div class="led"></div>
      <div class="led"></div><div class="led"></div><div class="led"></div>
      <div class="led"></div><div class="led"></div><div class="led"></div>
      <div class="led"></div><div class="led"></div><div class="led"></div>
    </div>

    <!-- Carretes -->
    <div id="reels-container">
      <div class="reel-wrapper" id="rw0"><div class="reel" id="reel0"></div></div>
      <div class="reel-wrapper" id="rw1"><div class="reel" id="reel1"></div></div>
      <div class="reel-wrapper" id="rw2"><div class="reel" id="reel2"></div></div>
    </div>

    <!-- Mensaje de resultado -->
    <div id="result-display">🎰 ¡Pulsa GIRAR para jugar!</div>
  </div>

  <!-- Info saldo / victoria -->
  <div id="info-panel">
    <div class="info-box">
      <div class="info-label">💰 Saldo</div>
      <div class="info-value" id="balance-display">500</div>
    </div>
    <div class="info-box">
      <div class="info-label">🏆 Última ganancia</div>
      <div class="info-value" id="win-display">–</div>
    </div>
    <div class="info-box">
      <div class="info-label">🎯 Giros</div>
      <div class="info-value" id="spins-display">0</div>
    </div>
  </div>

  <!-- Control apuesta -->
  <div id="bet-control">
    <button class="bet-btn" id="bet-down">−</button>
    <div id="bet-display">APUESTA<span id="bet-value">10</span></div>
    <button class="bet-btn" id="bet-up">+</button>
  </div>

  <!-- Botón principal -->
  <button id="spin-btn">🎰 GIRAR</button>

  <!-- Tabla pagos -->
  <div id="paytable-toggle" onclick="togglePaytable()">📋 Ver tabla de pagos ▼</div>
  <div id="paytable">
    <div class="pt-row"><span>🍒🍒🍒 Triple Cereza</span><span class="pt-mult">×8</span></div>
    <div class="pt-row"><span>🍋🍋🍋 Triple Limón</span><span class="pt-mult">×8</span></div>
    <div class="pt-row"><span>🍊🍊🍊 Triple Naranja</span><span class="pt-mult">×15</span></div>
    <div class="pt-row"><span>🍇🍇🍇 Triple Uvas</span><span class="pt-mult">×25</span></div>
    <div class="pt-row"><span>⭐⭐⭐ Triple Estrella</span><span class="pt-mult">×60</span></div>
    <div class="pt-row"><span>💎💎💎 Triple Diamante</span><span class="pt-mult">×150</span></div>
    <div class="pt-row"><span>7️⃣7️⃣7️⃣ JACKPOT</span><span class="pt-mult" style="color:#fff;text-shadow:0 0 10px gold">×500 🎉</span></div>
    <div class="pt-row" style="margin-top:6px;font-size:.7rem;color:#555">
      <span>RTP ≈ 71% · House edge ≈ 29%</span>
    </div>
  </div>

  <!-- Stats -->
  <div id="stats-bar">
    <div class="stat">Gastado: <span class="stat-val" id="stat-spent">0</span>🪙</div>
    <div class="stat">Ganado: <span class="stat-val" id="stat-won">0</span>🪙</div>
    <div class="stat">RTP: <span class="stat-val" id="stat-rtp">–</span></div>
  </div>

</div>

<script>
/* ═══════════════════════════════════════════════════════
   MOTOR DEL JUEGO (mismo algoritmo que slot_engine.py)
═══════════════════════════════════════════════════════ */
const SYMBOLS = [
  { e: '🍒', w: 40, m3: 8  },
  { e: '🍋', w: 25, m3: 8  },
  { e: '🍊', w: 15, m3: 15 },
  { e: '🍇', w: 10, m3: 25 },
  { e: '⭐', w: 5,  m3: 60 },
  { e: '💎', w: 3,  m3: 150},
  { e: '7️⃣', w: 2,  m3: 500},
];
const TOTAL_W = SYMBOLS.reduce((a,s) => a + s.w, 0);

function spinReel() {
  let r = Math.random() * TOTAL_W;
  for (const s of SYMBOLS) { r -= s.w; if (r <= 0) return s.e; }
  return SYMBOLS[0].e;
}
function adjacent(emoji) {
  const idx = SYMBOLS.findIndex(s => s.e === emoji);
  const pool = SYMBOLS.filter((_,i) => i !== idx);
  const weights = pool.map((_,i) => Math.max(1, 5 - Math.abs(i - idx)));
  const total = weights.reduce((a,b) => a+b, 0);
  let r = Math.random() * total;
  for (let i = 0; i < pool.length; i++) { r -= weights[i]; if (r <= 0) return pool[i].e; }
  return pool[0].e;
}
function getSymbol(e) { return SYMBOLS.find(s => s.e === e); }

function doSpin(bet) {
  let r1 = spinReel(), r2 = spinReel(), r3 = spinReel();
  let win = 0, isJackpot = false, isNearMiss = false, msg = '';

  if (r1 === r2 && r2 === r3) {
    const sym = getSymbol(r1);
    win = bet * sym.m3;
    isJackpot = (r1 === '7️⃣');
    if (isJackpot)          msg = '🎉🎊 ¡¡JACKPOT!! TRES SIETES 🤑';
    else if (r1==='💎')     msg = '💎 ¡TRIPLE DIAMANTE!';
    else if (r1==='⭐')     msg = '⭐ ¡TRIPLE ESTRELLA!';
    else                    msg = `${r1} ¡TRIPLE ${sym.m3>10?'GRANDE':''}!  ×${sym.m3}`;
  } else if (Math.random() < 0.30) {
    if (r1 === r2)       { r3 = adjacent(r1); }
    else if (r2 === r3)  { r1 = adjacent(r2); }
    else                 { r3 = r2; r1 = adjacent(r2); }
    isNearMiss = true;
    const msgs = ['😩 ¡Casi! Estuvo rozando...','🤏 Por un pelo. ¡Siguiente!','😤 ¡Qué mala suerte!','💨 ¡Se escapó!'];
    msg = msgs[Math.floor(Math.random()*msgs.length)];
  } else {
    const msgs = ['😕 Sin suerte esta vez.','🎰 ¡Sigue intentando!','🤞 ¡La fortuna es caprichosa!'];
    msg = msgs[Math.floor(Math.random()*msgs.length)];
  }
  return { r1, r2, r3, win, isJackpot, isNearMiss, msg };
}

/* ═══════════════════════════════════════════════════════
   ESTADO DEL JUGADOR
═══════════════════════════════════════════════════════ */
const state = {
  balance: 500, bet: 10, spins: 0, totalWon: 0, totalSpent: 0,
  spinning: false,
};

/* ═══════════════════════════════════════════════════════
   AUDIO ENGINE (Web Audio API — sin archivos externos)
═══════════════════════════════════════════════════════ */
let audioCtx = null;
function getCtx() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  if (audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}

function playTone(freq, type, startTime, duration, gain=0.3, fadeOut=true) {
  const ctx = getCtx();
  const osc = ctx.createOscillator();
  const env = ctx.createGain();
  osc.connect(env); env.connect(ctx.destination);
  osc.type = type; osc.frequency.value = freq;
  env.gain.setValueAtTime(gain, startTime);
  if (fadeOut) env.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
  osc.start(startTime); osc.stop(startTime + duration + 0.01);
}

function sfxSpin() {
  const ctx = getCtx(), now = ctx.currentTime;
  // Ruido mecánico de carrete
  for (let i = 0; i < 8; i++) {
    const freq = 80 + Math.random()*120;
    playTone(freq, 'sawtooth', now + i*0.07, 0.12, 0.08);
  }
}

function sfxTickSpin(t) {
  const ctx = getCtx();
  const freq = 200 + Math.random()*100;
  playTone(freq, 'square', ctx.currentTime + t, 0.04, 0.1);
}

function sfxStop(reelIdx) {
  const ctx = getCtx(), now = ctx.currentTime;
  playTone(120 + reelIdx*40, 'triangle', now, 0.15, 0.25);
  // "Thunk"
  const buf = ctx.createBuffer(1, ctx.sampleRate*0.1, ctx.sampleRate);
  const data = buf.getChannelData(0);
  for (let i=0; i<data.length; i++) data[i] = (Math.random()*2-1) * Math.exp(-i/(ctx.sampleRate*0.03));
  const src = ctx.createBufferSource();
  src.buffer = buf;
  const g = ctx.createGain(); g.gain.value = 0.3;
  src.connect(g); g.connect(ctx.destination);
  src.start(now);
}

function sfxWin(multiplier) {
  const ctx = getCtx(), now = ctx.currentTime;
  const scale = [261,294,330,349,392,440,494,523];
  const steps = Math.min(Math.ceil(multiplier/10) + 3, 8);
  for (let i=0; i<steps; i++) {
    playTone(scale[i]*((multiplier>20)?2:1), 'sine', now + i*0.1, 0.3, 0.35);
    if (multiplier > 15) playTone(scale[i]*1.5, 'triangle', now + i*0.1 + 0.05, 0.25, 0.15);
  }
}

function sfxJackpot() {
  const ctx = getCtx(), now = ctx.currentTime;
  const freqs = [523,659,784,1047,1319,1568,2093];
  freqs.forEach((f,i) => {
    playTone(f, 'sine',     now + i*0.12, 1.5, 0.5);
    playTone(f*1.5, 'triangle', now + i*0.12+0.06, 1.2, 0.3);
  });
  // Redoble final
  for (let i=0; i<16; i++) {
    playTone(1047, 'square', now + 0.84 + i*0.06, 0.05, 0.2);
  }
}

function sfxNearMiss() {
  const ctx = getCtx(), now = ctx.currentTime;
  playTone(440,'sine',now,0.2,0.3);
  playTone(415,'sawtooth',now+0.2,0.3,0.2);
  playTone(392,'triangle',now+0.5,0.4,0.15);
}

function sfxCoin(count=1) {
  const ctx = getCtx();
  for (let i=0; i<Math.min(count,6); i++) {
    const t = ctx.currentTime + i*0.08;
    playTone(1200+Math.random()*400, 'sine', t, 0.12, 0.2);
  }
}

/* ═══════════════════════════════════════════════════════
   ANIMACIÓN DE CARRETES
═══════════════════════════════════════════════════════ */
const REEL_SYMBOLS = SYMBOLS.map(s => s.e);
const CELL_H = 100;

function buildReel(reelEl, symbols) {
  reelEl.innerHTML = '';
  // Ponemos una secuencia larga para la animación de giro
  const pool = [...symbols, ...symbols, ...symbols, ...symbols, ...symbols];
  pool.forEach(e => {
    const cell = document.createElement('div');
    cell.className = 'reel-cell';
    cell.textContent = e;
    reelEl.appendChild(cell);
  });
}

// Inicializar carretes
const reelEls = [
  document.getElementById('reel0'),
  document.getElementById('reel1'),
  document.getElementById('reel2'),
];
const reelWrappers = [
  document.getElementById('rw0'),
  document.getElementById('rw1'),
  document.getElementById('rw2'),
];

// Generar una tira de símbolos aleatoria para cada carrete
function randomStrip(len=20) {
  const strip = [];
  for (let i=0; i<len; i++) strip.push(REEL_SYMBOLS[Math.floor(Math.random()*REEL_SYMBOLS.length)]);
  return strip;
}

let strips = [randomStrip(), randomStrip(), randomStrip()];

function initReels() {
  for (let i=0; i<3; i++) {
    buildReel(reelEls[i], strips[i]);
    // Posición inicial centrada en símbolo 2
    reelEls[i].style.transition = 'none';
    reelEls[i].style.transform = `translateY(${-CELL_H * 2}px)`;
  }
}
initReels();

// Animar giro: el carrete se mueve rápido y se detiene en el símbolo correcto
function spinReelAnimation(reelIdx, targetSymbol) {
  return new Promise(resolve => {
    const reelEl = reelEls[reelIdx];

    // Construir nueva tira con el símbolo destino al final
    const newStrip = randomStrip(18);
    newStrip.push(targetSymbol); // posición 18 = destino
    newStrip.push(...randomStrip(3));
    buildReel(reelEl, newStrip);

    const targetPos = -(CELL_H * 18); // el símbolo destino está en índice 18
    const startPos = 0;
    const duration = 0.8 + reelIdx * 0.35; // cada carrete para más tarde

    reelEl.style.transition = 'none';
    reelEl.style.transform = `translateY(${startPos}px)`;

    // Ticks de sonido durante el giro
    const tickCount = Math.floor(duration / 0.08);
    for (let i=0; i<tickCount; i++) sfxTickSpin(i * 0.08);

    // Forzar reflow
    reelEl.getBoundingClientRect();

    setTimeout(() => {
      // Movimiento con ease-out (giro rápido → frena)
      reelEl.style.transition = `transform ${duration}s cubic-bezier(0.1, 0.8, 0.3, 1)`;
      reelEl.style.transform = `translateY(${targetPos}px)`;

      setTimeout(() => {
        sfxStop(reelIdx);
        // Pequeño bounce
        reelEl.style.transition = 'transform 0.12s cubic-bezier(0.34,1.56,0.64,1)';
        reelEl.style.transform = `translateY(${targetPos + 8}px)`;
        setTimeout(() => {
          reelEl.style.transform = `translateY(${targetPos}px)`;
          resolve();
        }, 120);
      }, duration * 1000);
    }, 20);
  });
}

/* ═══════════════════════════════════════════════════════
   PARTÍCULAS FX (Canvas overlay)
═══════════════════════════════════════════════════════ */
const fxCanvas = document.getElementById('fx-canvas');
const fxCtx = fxCanvas.getContext('2d');
let particles = [];

function resizeCanvases() {
  fxCanvas.width  = window.innerWidth;
  fxCanvas.height = window.innerHeight;
  bgCanvas.width  = window.innerWidth;
  bgCanvas.height = window.innerHeight;
}
window.addEventListener('resize', resizeCanvases);
resizeCanvases();

class Particle {
  constructor(x, y, opts={}) {
    this.x = x; this.y = y;
    this.vx = (Math.random()-0.5) * (opts.spread||12);
    this.vy = -Math.random() * (opts.speed||8) - 2;
    this.life = 1; this.decay = 0.015 + Math.random()*0.02;
    this.size = opts.size || (4 + Math.random()*6);
    this.color = opts.color || `hsl(${Math.random()*60+30},100%,60%)`;
    this.gravity = opts.gravity ?? 0.25;
    this.shape = opts.shape || 'circle'; // 'circle' | 'rect' | 'star'
    this.rotation = Math.random() * Math.PI * 2;
    this.rotSpeed = (Math.random()-0.5)*0.3;
  }
  update() {
    this.x += this.vx; this.y += this.vy;
    this.vy += this.gravity;
    this.vx *= 0.98;
    this.life -= this.decay;
    this.rotation += this.rotSpeed;
  }
  draw(ctx) {
    ctx.save();
    ctx.globalAlpha = Math.max(0, this.life);
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotation);
    ctx.fillStyle = this.color;
    if (this.shape === 'rect') {
      ctx.fillRect(-this.size/2, -this.size/2, this.size, this.size*0.6);
    } else if (this.shape === 'star') {
      drawStar(ctx, 0, 0, this.size*0.5, this.size, 5);
      ctx.fill();
    } else {
      ctx.beginPath();
      ctx.arc(0, 0, this.size/2, 0, Math.PI*2);
      ctx.fill();
    }
    ctx.restore();
  }
}

function drawStar(ctx, cx, cy, ir, or, n) {
  ctx.beginPath();
  for (let i=0; i<n*2; i++) {
    const r = i%2===0 ? or : ir;
    const a = (i * Math.PI) / n - Math.PI/2;
    i===0 ? ctx.moveTo(cx+r*Math.cos(a), cy+r*Math.sin(a))
           : ctx.lineTo(cx+r*Math.cos(a), cy+r*Math.sin(a));
  }
  ctx.closePath();
}

function spawnParticles(x, y, count, opts) {
  for (let i=0; i<count; i++) particles.push(new Particle(x, y, opts));
}

function spawnWinBurst(x, y) {
  spawnParticles(x, y, 60, { spread:14, speed:10, color:'#ffd700', shape:'star', size:8 });
  spawnParticles(x, y, 40, { spread:10, speed:7, color:'#ffaa00', shape:'rect' });
  spawnParticles(x, y, 30, { spread:16, speed:12, color:'#ffffff', shape:'circle', size:5 });
}

function spawnJackpotBurst() {
  const w = fxCanvas.width, h = fxCanvas.height;
  const colors = ['#ffd700','#ff2244','#00ff88','#00aaff','#cc44ff','#ffffff'];
  for (let i=0; i<300; i++) {
    const x = Math.random()*w, y = Math.random()*h*0.6;
    const c = colors[Math.floor(Math.random()*colors.length)];
    const shapes = ['circle','rect','star'];
    spawnParticles(x, y, 1, { spread:18, speed:12, color:c, shape:shapes[i%3], size:6+Math.random()*8, gravity:0.15 });
  }
}

function spawnCoinSplash(x, y, amount) {
  const count = Math.min(Math.ceil(amount/5), 25);
  spawnParticles(x, y, count, { spread:8, speed:6, color:'#ffd700', shape:'circle', size:6, gravity:0.4 });
}

function animFX() {
  fxCtx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);
  particles = particles.filter(p => p.life > 0);
  particles.forEach(p => { p.update(); p.draw(fxCtx); });
  requestAnimationFrame(animFX);
}
animFX();

/* ═══════════════════════════════════════════════════════
   FONDO ANIMADO (estrellas flotantes)
═══════════════════════════════════════════════════════ */
const bgCanvas = document.getElementById('bg-canvas');
const bgCtx    = bgCanvas.getContext('2d');
const STARS = Array.from({length:80}, () => ({
  x: Math.random(), y: Math.random(),
  r: 0.5+Math.random()*1.5,
  speed: 0.00002 + Math.random()*0.00005,
  alpha: 0.1+Math.random()*0.6,
  phase: Math.random()*Math.PI*2,
}));

function animBG(t) {
  const w = bgCanvas.width, h = bgCanvas.height;
  bgCtx.clearRect(0,0,w,h);
  STARS.forEach(s => {
    const a = s.alpha * (0.5 + 0.5 * Math.sin(t*0.001 + s.phase));
    bgCtx.fillStyle = `rgba(255,255,255,${a})`;
    bgCtx.beginPath();
    bgCtx.arc(s.x*w, s.y*h, s.r, 0, Math.PI*2);
    bgCtx.fill();
    s.y = (s.y + s.speed) % 1;
  });
  requestAnimationFrame(animBG);
}
animBG(0);

/* ═══════════════════════════════════════════════════════
   UI HELPERS
═══════════════════════════════════════════════════════ */
function updateUI() {
  const bd = document.getElementById('balance-display');
  bd.textContent = state.balance;
  bd.classList.remove('bump');
  void bd.offsetWidth;
  bd.classList.add('bump');

  document.getElementById('spins-display').textContent = state.spins;
  document.getElementById('bet-value').textContent     = state.bet;

  const spent = state.totalSpent, won = state.totalWon;
  document.getElementById('stat-spent').textContent = spent;
  document.getElementById('stat-won').textContent   = won;
  document.getElementById('stat-rtp').textContent   =
    spent > 0 ? (won/spent*100).toFixed(1)+'%' : '–';
}

function setResult(msg, type='') {
  const el = document.getElementById('result-display');
  el.textContent = msg;
  el.className = type;
}

function showWinAmount(amount) {
  const el = document.getElementById('win-display');
  el.textContent = amount > 0 ? `+${amount}🪙` : '–';
  el.style.color = amount > 0 ? 'var(--gold)' : '#666';
}

function bump(id) {
  const el = document.getElementById(id);
  el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump');
}

/* ═══════════════════════════════════════════════════════
   GIRAR PRINCIPAL
═══════════════════════════════════════════════════════ */
async function performSpin() {
  if (state.spinning) return;
  if (state.balance < state.bet) {
    setResult('💸 ¡Sin fichas! Recarga.', 'lose');
    return;
  }

  // Despertar AudioContext con gesto del usuario
  getCtx();

  state.spinning = true;
  state.balance -= state.bet;
  state.totalSpent += state.bet;
  state.spins++;

  document.getElementById('spin-btn').disabled = true;
  setResult('🎰 Girando...', '');
  showWinAmount(0);
  sfxSpin();

  // Calcular resultado
  const result = doSpin(state.bet);

  // Animar los 3 carretes en paralelo (con delay escalonado)
  await Promise.all([
    spinReelAnimation(0, result.r1),
    spinReelAnimation(1, result.r2),
    spinReelAnimation(2, result.r3),
  ]);

  // Actualizar estado
  state.balance += result.win;
  state.totalWon += result.win;
  updateUI();
  showWinAmount(result.win);

  // Efectos según resultado
  if (result.isJackpot) {
    await triggerJackpot(result);
  } else if (result.win > 0) {
    triggerWin(result);
  } else if (result.isNearMiss) {
    triggerNearMiss(result);
  } else {
    triggerLose(result);
  }

  state.spinning = false;
  document.getElementById('spin-btn').disabled = false;
}

function triggerWin(result) {
  const { win, msg } = result;
  setResult(msg, 'win');
  sfxWin(win / state.bet);

  // Flash en los carretes ganadores
  reelWrappers.forEach(rw => {
    rw.classList.remove('win-flash'); void rw.offsetWidth; rw.classList.add('win-flash');
  });

  // Partículas sobre la máquina
  const machine = document.getElementById('machine');
  const rect = machine.getBoundingClientRect();
  const cx = rect.left + rect.width/2;
  const cy = rect.top + 80;
  spawnWinBurst(cx, cy);

  // Monedas proporcionales al premio
  sfxCoin(Math.ceil(win/state.bet));
  document.body.classList.remove('win-bg'); void document.body.offsetWidth;
  document.body.classList.add('win-bg');

  // Texto flotante de ganancia
  showFloatingText(`+${win}🪙`, cx, cy-30, '#ffd700');
}

async function triggerJackpot(result) {
  setResult(result.msg, 'jackpot');
  sfxJackpot();

  document.body.classList.remove('jackpot-bg'); void document.body.offsetWidth;
  document.body.classList.add('jackpot-bg');

  reelWrappers.forEach(rw => {
    rw.classList.remove('win-flash'); void rw.offsetWidth; rw.classList.add('win-flash');
  });

  spawnJackpotBurst();

  // Overlay jackpot
  document.getElementById('jackpot-win').textContent = `¡Ganaste ${result.win}🪙!`;
  await new Promise(r => setTimeout(r, 800));
  document.getElementById('jackpot-overlay').classList.add('show');
}

function triggerNearMiss(result) {
  setResult(result.msg, 'near');
  sfxNearMiss();
  document.body.classList.remove('shake'); void document.body.offsetWidth;
  document.body.classList.add('shake');
}

function triggerLose(result) {
  setResult(result.msg, 'lose');
}

/* ═══════════════════════════════════════════════════════
   TEXTO FLOTANTE
═══════════════════════════════════════════════════════ */
function showFloatingText(text, x, y, color='#ffd700') {
  const el = document.createElement('div');
  el.textContent = text;
  Object.assign(el.style, {
    position:'fixed', left:x+'px', top:y+'px',
    color, fontWeight:'900', fontSize:'1.6rem',
    textShadow:`0 0 10px ${color}`,
    pointerEvents:'none', zIndex:'150',
    transform:'translateX(-50%)',
    transition:'all 1s ease-out',
    opacity:'1',
  });
  document.body.appendChild(el);
  requestAnimationFrame(() => {
    el.style.top = (y-80)+'px';
    el.style.opacity = '0';
  });
  setTimeout(() => el.remove(), 1200);
}

/* ═══════════════════════════════════════════════════════
   CONTROLES
═══════════════════════════════════════════════════════ */
document.getElementById('spin-btn').addEventListener('click', performSpin);

document.getElementById('bet-up').addEventListener('click', () => {
  const steps = [5,10,20,50,100,200,500];
  const idx = steps.indexOf(state.bet);
  if (idx < steps.length-1) { state.bet = steps[idx+1]; updateUI(); }
});
document.getElementById('bet-down').addEventListener('click', () => {
  const steps = [5,10,20,50,100,200,500];
  const idx = steps.indexOf(state.bet);
  if (idx > 0) { state.bet = steps[idx-1]; updateUI(); }
});

document.getElementById('jackpot-close').addEventListener('click', () => {
  document.getElementById('jackpot-overlay').classList.remove('show');
});

// Teclado: Space = girar
document.addEventListener('keydown', e => {
  if (e.code === 'Space' || e.code === 'Enter') { e.preventDefault(); performSpin(); }
});

function togglePaytable() {
  document.getElementById('paytable').classList.toggle('open');
  document.getElementById('paytable-toggle').textContent =
    document.getElementById('paytable').classList.contains('open')
      ? '📋 Ocultar tabla de pagos ▲'
      : '📋 Ver tabla de pagos ▼';
}

/* ═══════════════════════════════════════════════════════
   TELEGRAM WEB APP (si está disponible)
═══════════════════════════════════════════════════════ */
if (window.Telegram?.WebApp) {
  const tg = window.Telegram.WebApp;
  tg.ready();
  tg.expand();
  // Adaptar colores al tema de Telegram
  document.documentElement.style.setProperty('--dark', tg.themeParams.bg_color || '#0a0a0f');
}

/* ═══════════════════════════════════════════════════════
   INIT
═══════════════════════════════════════════════════════ */
updateUI();
</script>
</body>
</html>
