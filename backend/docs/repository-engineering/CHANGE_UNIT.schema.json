{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcValls/BAGO/blob/main/backend/docs/repository-engineering/CHANGE_UNIT.schema.json",
  "title": "BAGO Repository Engineering Change Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "operation",
    "target_module",
    "allowed_files",
    "allowed_dependencies",
    "forbidden_dependencies",
    "public_contract_changes",
    "required_tests",
    "required_evidence",
    "closure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "operation": {
      "enum": ["feature", "refactor", "modularize", "verify", "govern"]
    },
    "target_module": {
      "type": "string",
      "minLength": 1
    },
    "allowed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "public_contract_changes": {
      "type": "boolean"
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "closure": {
      "enum": ["PREPARED", "EXECUTED", "VERIFIED", "VALIDATED"]
    },
    "behavior_change_authorized": {
      "type": "boolean",
      "default": false
    },
    "boundary_escalation": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verification_receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "acceptance_authority": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "modularize" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "required_evidence": {
            "contains": { "const": "characterization_tests" }
          },
          "boundary_escalation": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "govern" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "public_contract_changes": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": { "closure": { "enum": ["VERIFIED", "VALIDATED"] } },
        "required": ["closure"]
      },
      "then": {
        "required": ["candidate_sha", "verification_receipts"]
      }
    },
    {
      "if": {
        "properties": { "closure": { "const": "VALIDATED" } },
        "required": ["closure"]
      },
      "then": {
        "required": ["acceptance_authority"]
      }
    }
  ]
}
