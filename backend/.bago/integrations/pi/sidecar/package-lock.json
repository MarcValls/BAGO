{
  "name": "bago-pi-sidecar-lockfile",
  "version": "0.1.0",
  "lockfileVersion": 0,
  "description": "Lockfile witness for BagoPiBridge sidecar. Zero dependencies. Hash is read at runtime for integrity.",
  "dependencies": {},
  "integrity": {
    "sidecar_artifact_hash_algorithm": "sha256-truncated-16",
    "sidecar_artifact_hash_files": [
      "src/main.js",
      "src/protocol.js",
      "src/runtime_guard.js",
      "src/provider_attestation.js",
      "src/provider_runner.js"
    ]
  }
}
