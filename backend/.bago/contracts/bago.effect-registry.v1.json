{
  "contract": "bago.effect-registry.v1",
  "version": "1.24.0",
  "status": "active",
  "principles": [
    "Every material or persistent effect must have a canonical effect_id.",
    "Effect relevance or intent never grants execution authority.",
    "Compound execution cannot grant more authority than its strongest child effect.",
    "Strong human proof is required by policy only after the effect is normalized.",
    "A sink may be gateway-bound or explicitly internal, but never silently unclassified."
  ],
  "risk_levels": {
    "E0": "read-only/local observation",
    "E1": "ephemeral or remote read with no persistent mutation",
    "E2": "low-risk persistent BAGO state mutation",
    "E3": "workspace material mutation or scoped execution",
    "E4": "external mutation, process execution, or installation",
    "E5": "privileged, destructive, credential, or system mutation",
    "E6": "persistent delegation capable of causing future effects"
  },
  "authorization_modes": {
    "policy": "backend policy may allow without an interactive user challenge",
    "explicit": "requires operation-bound user authorization or a valid delegation",
    "strong": "requires operation-bound strong human authorization",
    "inherit_max_child": "compound operation inherits the strongest authorization requirement of all child effects"
  },
