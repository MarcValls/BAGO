# Normalize all text files to LF on checkout and check-in.
* text=auto eol=lf

# Explicitly mark common source files as text with LF endings.
*.md       text eol=lf
*.py       text eol=lf
*.pyi      text eol=lf
*.js       text eol=lf
*.cjs      text eol=lf
*.mjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.less     text eol=lf
*.html     text eol=lf
*.htm      text eol=lf
*.xml      text eol=lf
*.svg      text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.fish     text eol=lf
*.ps1      text eol=lf
*.bat      text eol=lf
*.cmd      text eol=lf
*.dockerfile text eol=lf
*.env      text eol=lf
*.env.*    text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# Explicitly mark common binary files as non-text so Git never touches them.
*.png      -text
*.jpg      -text
*.jpeg     -text
*.gif      -text
*.webp     -text
*.bmp      -text
*.ico      -text
*.pdf      -text
*.pptx     -text
*.docx     -text
*.xlsx     -text
*.zip      -text
*.tar      -text
*.gz       -text
*.tgz      -text
*.bz2      -text
*.7z       -text
*.mp3      -text
*.mp4      -text
*.avi      -text
*.mov      -text
*.woff     -text
*.woff2    -text
*.ttf      -text
*.otf      -text
*.eot      -text
*.exe      -text
*.dll      -text
*.so       -text
*.dylib    -text
*.bin      -text

# Keep BAGO core context patterns and evidence docs as LF.
backend/.bago/core/context_patterns/** text eol=lf
backend/docs/evidence/** text eol=lf
