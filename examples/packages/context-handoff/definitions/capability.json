{
  "id": "local.context-handoff",
  "runtime": {
    "kind": "python",
    "timeout_s": 15
  },
  "configuration_schema": {
    "type": "object",
    "properties": {}
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {"type": "string", "minLength": 1},
      "agent_role": {"type": "string", "minLength": 1},
      "work_item": {"type": "string", "minLength": 1},
      "version": {"type": "string", "minLength": 1},
      "cycle": {"type": "string", "minLength": 1},
      "status": {"type": "string", "enum": ["ON", "HANDOFF", "OFF", "CANON", "DRAFT"]},
      "result": {"type": "string"},
      "decisions": {"type": "string"},
      "open_items": {"type": "string"},
      "next_role": {"type": "string"},
      "next_instruction": {"type": "string"},
      "inherited_context": {"type": "string"},
      "sources": {"type": "string"},
      "success_criteria": {"type": "string"}
    },
    "required": ["project", "agent_role", "work_item", "version", "cycle", "status", "result"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "title": {"type": "string"},
      "status": {"type": "string"},
      "handoff_markdown": {"type": "string"}
    },
    "required": ["title", "status", "handoff_markdown"]
  },
  "tags": ["continuity", "memory", "handoff", "srg-derived"]
}
