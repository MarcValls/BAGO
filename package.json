{
  "name": "bago-monorepo",
  "version": "4.9.3",
  "private": true,
  "description": "BAGO monorepo (frontend + backend + electron viewer)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 start",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 start",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 stop",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 restart",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 status",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 logs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 build",
    "typecheck": "npm run typecheck --workspace frontend",
    "test:frontend": "npm run test --workspace frontend",
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 backend",
    "electron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 electron",
    "sh:dev": "bash scripts/dev.sh start",
    "sh:stop": "bash scripts/dev.sh stop",
    "sh:status": "bash scripts/dev.sh status"
  },
  "workspaces": [
    "frontend",
    "electron-viewer"
  ]
}
