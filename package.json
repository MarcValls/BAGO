{
  "name": "bago-installation-manager",
  "version": "4.3.0",
  "private": true,
  "description": "Electron packaged installation manager for BAGO.",
  "main": "electron/main.cjs",
  "author": "BAGO",
  "license": "UNLICENSED",
  "scripts": {
    "manager:dev": "electron .",
    "manager:pack": "electron-builder --dir",
    "manager:dist": "electron-builder --win nsis",
    "manager:test-jobs": "node tests/test_release_job_manager.cjs",
    "manager:test-jobs-live": "node tests/test_release_job_manager_live.cjs"
  },
  "build": {
    "appId": "com.bago.installation-manager",
    "productName": "BAGO Installation Manager",
    "artifactName": "BAGO-Installation-Manager-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "bago_core/**/*",
      ".bago/**/*",
      "scripts/**/*",
      "tools/**/*",
      "docs/**/*",
      "install-v4.ps1",
      "install-remote.ps1",
      "bago.ps1",
      "bago.cmd",
      "bago.sh",
      "versions.json",
      "release_version.txt"
    ],
    "files": [
      "electron/**/*",
      "manager/**/*",
      "bago.ico",
      "assets/**/*",
      "bago_core/**/*",
      ".bago/core/**/*",
      ".bago/chat/**/*",
      ".bago/knowledge/**/*",
      ".bago/providers/**/*",
      ".bago/api/**/*",
      ".bago/tools/**/*",
      "docs/**/*",
      "scripts/**/*",
      "tools/**/*",
      "install-v4.ps1",
      "install-remote.ps1",
      "bago.ps1",
      "bago.cmd",
      "bago.sh",
      "versions.json",
      "release_version.txt"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "bago.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BAGO Installation Manager"
    }
  },
  "devDependencies": {
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "playwright": "^1.60.0"
  }
}
