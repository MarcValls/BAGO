backend/release/v4/
releases/compiled/
releases/bago-*-distribution.zip
releases/bago-*-distribution.zip.sha256
releases/bago-*-setup.exe
releases/bago-*-setup.exe.sha256
# Locally archived historical release payloads are retained but not source files.
releases/archive/v*/bago-*
releases/archive/v*/BAGO-*
releases/archive/v*/latest.yml
releases/archive/v*/legacy-release-snapshot/
bago-release-*/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# Build output
frontend/dist/
backend/ui-react/dist/

# Local MSIX and SignPath payload builds; receipts and manifests stay visible.
/artifacts/msix-*/host-publish/
/artifacts/msix-*/pri/
/artifacts/msix-*/stage/
/artifacts/msix-*/BAGO-Bootstrap-*.msix
/artifacts/msix-*/python-*-embed-amd64.zip
/artifacts/signpath-candidate-*/payload/
/artifacts/ieb-proof-*/CredUiProbe/bin/
/artifacts/ieb-proof-*/CredUiProbe/obj/

