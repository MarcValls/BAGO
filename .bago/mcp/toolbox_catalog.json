  "composite_tools": {

    "release_guard": {
      "label": "Release Guard — Puerta de release completa",
      "description": "Pipeline completo antes de publicar una release: quality + security + health + validation",
      "pipeline": ["health", "secrets", "review", "types", "hardcode", "audit commit", "audit push", "validate", "sync"],
      "tags": ["release", "gate", "quality", "security"],
      "trigger": "before:release",
      "agent": "CENTINELA_SINCERIDAD",
      "severity_threshold": "block_on_high"
    },

    "sprint_kickoff": {
      "label": "Sprint Kickoff — Inicio de sprint completo",
      "description": "Prepara el entorno, asigna toolboxes, verifica health y abre el sprint",
      "pipeline": ["health", "deps", "env_check", "sprint create", "work_matrix", "toolsmith assign"],
      "tags": ["sprint", "start", "planning"],
      "trigger": "on:sprint_start",
      "agent": "ORGANIZADOR_Entregables"
    },

    "sprint_close": {
      "label": "Sprint Close — Cierre de sprint completo",
      "description": "Cierra el sprint, genera changelog, reportes y snapshots del estado",
      "pipeline": ["audit commit", "health report", "sprint summary", "changelog_gen", "session close", "snapshot"],
      "tags": ["sprint", "close", "reporting"],
      "trigger": "on:sprint_end",
      "agent": "ORGANIZADOR_Entregables"
    },

    "deep_quality": {
      "label": "Deep Quality — Análisis de calidad máxima",
      "description": "Revisión exhaustiva: estática, tipos, nombres, deuda, código muerto, hardcodes y español",
      "pipeline": ["review", "types", "naming", "dead_code", "hardcode", "spanish", "debt", "audit scan"],
      "tags": ["quality", "deep-review", "refactor"],
      "trigger": "before:major_refactor",
      "agent": "ANALISTA_Contexto"
    },

    "project_snapshot": {
      "label": "Project Snapshot — Estado completo del proyecto",
      "description": "Captura el estado actual: git, diff, stats, summary y snapshot persistente",
      "pipeline": ["context git", "diff", "session stats", "project state", "snapshot"],
      "tags": ["snapshot", "state", "reporting"],
      "trigger": "on:checkpoint",
      "agent": "ANALISTA_Contexto"
    },

    "onboard_project": {
      "label": "Onboard Project — Incorporar proyecto nuevo",
