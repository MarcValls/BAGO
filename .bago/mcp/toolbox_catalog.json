      "pipeline": ["project init", "env_setup", "deps", "config-check", "doctor", "validate", "hello"],
      "tags": ["onboarding", "setup", "new-project"],
      "trigger": "on:new_project",
      "agent": "ADAPTADOR_PROYECTO"
    },

    "security_sweep": {
      "label": "Security Sweep — Barrido de seguridad completo",
      "description": "Pasa todos los escáneres de seguridad: secretos, riesgo, hardcodes y roles",
      "pipeline": ["secrets", "risk", "hardcode", "audit scan"],
      "tags": ["security", "sweep", "compliance"],
      "trigger": "before:deploy",
      "agent": "CENTINELA_SINCERIDAD"
    },

    "debug_focus": {
      "label": "Debug Focus — Foco de depuración",
      "description": "Herramientas para entender y resolver un bug: scan, review, riesgo, deuda e insights",
      "pipeline": ["context", "audit scan", "review", "risk", "debt", "insights", "npath recall"],
      "tags": ["debug", "bug", "investigation"],
      "trigger": "on:bug_report",
      "agent": "ANALISTA_Contexto"
    },

    "knowledge_sync": {
      "label": "Knowledge Sync — Sincronizar grafo de conocimiento",
      "description": "Actualiza el grafo npath con el estado actual: branch, commit, contexto y sesión",
      "pipeline": ["context git", "npath branch", "npath commit", "session close", "project state"],
      "tags": ["knowledge", "graph", "sync"],
      "trigger": "on:session_close",
      "agent": "MAESTRO_BAGO"
    },

    "content_batch": {
      "label": "Content Batch — Generación de contenido en lote",
      "description": "Regenera toda la documentación, README, COMMANDS y assets del proyecto",
      "pipeline": ["docs", "readme_sync", "changelog_gen", "context map"],
      "tags": ["documentation", "content", "batch"],
      "trigger": "before:release",
      "agent": "GENERADOR_Contenido"
    },

    "env_preflight": {
      "label": "Env Preflight — Verificación pre-vuelo de entorno",
      "description": "Verifica que el entorno está listo: Python, deps, config, puertos y health",
      "pipeline": ["doctor", "deps", "env_check", "config-check", "health score"],
      "tags": ["preflight", "env", "setup"],
      "trigger": "before:sprint",
      "agent": "ADAPTADOR_PROYECTO"
    },

    "monitoring_pulse": {
      "label": "Monitoring Pulse — Pulso de monitoreo continuo",
      "description": "Snapshot rápido de estado: health score, eficiencia, telemetría y alertas",
      "pipeline": ["health score", "recientes", "insights"],
      "tags": ["monitoring", "pulse", "telemetry"],
      "trigger": "on:schedule",
      "agent": "MAESTRO_BAGO"
    },

    "creative_pipeline": {
      "label": "Creative Pipeline — Pipeline creativo completo",
      "description": "Genera assets para proyectos creativos: música, imágenes, sprites",
      "pipeline": ["music plan", "image_gen", "image-studio", "sprite-studio"],
      "tags": ["creative", "media", "pipeline"],
      "trigger": "on:creative_sprint",
      "agent": "GENERADOR_Contenido"
    }
  },

