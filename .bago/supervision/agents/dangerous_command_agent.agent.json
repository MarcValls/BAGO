{
  "agent": "dangerous_command_agent",
  "version": "1.0.0",
  "role": "CENTINELA_SINCERIDAD",
  "mission": "Asegurar que todos los comandos dangerous tienen _self_test() aislado y funcional",
  "reads": [
    ".bago/tools/_registry_entries.py",
    ".bago/tools/spiral_loop.py",
    ".bago/supervision/artifacts/DANGEROUS_COMMANDS_MATRIX.json"
  ],
  "writes": [
    ".bago/supervision/artifacts/DANGEROUS_COMMANDS_MATRIX.json"
  ],
  "tools": ["tool_guardian.py", "ast"],
  "gate": "every dangerous command must have _self_test() and it must be callable via --self-test",
  "on_failure": "block_release",
  "loop": "pre_release_loop",
  "sense": "grep stability=dangerous in _registry_entries.py + check _self_test() presence",
  "plan": "compare registry dangerous list vs DANGEROUS_COMMANDS_MATRIX.json",
  "act": "flag any dangerous command missing _self_test()",
  "observe": "run python .bago/tools/tool_guardian.py and check GUARD-E001",
  "learn": "update DANGEROUS_COMMANDS_MATRIX.json with last_verified timestamp"
}
