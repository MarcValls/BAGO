  "loop": "contract_drift_loop",
  "sense": "python .bago/tools/tool_guardian.py",
  "plan": "compare health% against gate threshold",
  "act": "report GUARD-E001/E002/W001/W002 violations",
  "observe": "re-run tool_guardian after any fixes",
  "learn": "update REGISTRY_CONTRACT_AUDIT.json with health_pct + issues"
}
