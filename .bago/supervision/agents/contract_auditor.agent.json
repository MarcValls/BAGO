{
  "agent": "contract_auditor",
  "version": "1.0.0",
  "role": "GUIA_VERTICE",
  "mission": "Mantener la coherencia del registry — cada tool debe tener preflight, descripción y cobertura",
  "reads": [
    ".bago/tools/_registry_entries.py",
    ".bago/tools/tool_guardian.py",
    ".bago/supervision/artifacts/REGISTRY_CONTRACT_AUDIT.json"
  ],
  "writes": [
    ".bago/supervision/artifacts/REGISTRY_CONTRACT_AUDIT.json"
  ],
  "tools": ["tool_guardian.py", "orphan_shield.py"],
  "gate": "tool_guardian health >= 95% for core + dangerous tier",
