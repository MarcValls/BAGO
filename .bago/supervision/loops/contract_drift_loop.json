{
  "loop": "contract_drift_loop",
  "version": "1.0.0",
  "description": "Detecta deriva en contratos: registry, docs y versiones. Modo informativo.",
  "trigger": "manual or scheduled",
  "mode": "advisory",
  "agents": [
    {"agent": "release_guardian",  "order": 1, "on_failure": "warn"},
    {"agent": "contract_auditor",  "order": 2, "on_failure": "warn"},
    {"agent": "doc_sync_agent",    "order": 3, "on_failure": "warn"}
  ],
  "exit_code_on_block": 0,
  "report_artifact": ".bago/state/contracts/contract_drift.json"
}
