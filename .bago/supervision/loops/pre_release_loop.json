{
  "loop": "pre_release_loop",
  "version": "1.0.0",
  "description": "Se ejecuta antes de cualquier `bago version release`. Bloquea si algún gate falla.",
  "trigger": "before bago version release",
  "mode": "blocking",
  "agents": [
    {"agent": "release_guardian",      "order": 1, "on_failure": "block_release"},
    {"agent": "dangerous_command_agent","order": 2, "on_failure": "block_release"},
    {"agent": "contract_auditor",      "order": 3, "on_failure": "warn"},
    {"agent": "state_sandbox_agent",   "order": 4, "on_failure": "block_release"},
    {"agent": "doc_sync_agent",        "order": 5, "on_failure": "warn"}
  ],
  "exit_code_on_block": 1,
  "report_artifact": ".bago/state/contracts/pre_release_gate.json"
}
