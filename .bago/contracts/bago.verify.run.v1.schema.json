{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bago.local/contracts/bago.verify.run.v1.schema.json",
  "title": "BAGO verify run v1",
  "description": "Immutable evidence record for one non-mutating BAGO verification run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "profile", "started_at", "finished_at",
    "identity", "integrity", "preflight", "checks", "summary", "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "bago.verify.run.v1" },
    "run_id": { "type": "string", "pattern": "^VERIFY-[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$" },
    "profile": { "enum": ["quick", "standard", "release"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/identity" }, "end": { "$ref": "#/$defs/identity" } }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "identity_equal", "invalidating_reasons"],
      "properties": {
        "status": { "enum": ["VALID", "INVALIDATED"] },
        "identity_equal": { "type": "boolean" },
        "invalidating_reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "preflight": { "$ref": "#/$defs/preflight" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totals", "required_totals", "verdict"],
      "properties": {
        "totals": { "$ref": "#/$defs/totals" },
        "required_totals": { "$ref": "#/$defs/totals" },
        "verdict": { "enum": ["VERIFIED", "FAILED", "INCOMPLETE"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256sums", "entries"],
      "properties": {
        "sha256sums": { "const": "SHA256SUMS" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "integrity": { "properties": { "status": { "const": "INVALIDATED" } }, "required": ["status"] } } },
      "then": { "properties": { "summary": { "properties": { "verdict": { "const": "INCOMPLETE" } }, "required": ["verdict"] } } }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_root", "framework_root", "workspace_root", "git_head", "git_branch", "git_dirty", "worktree_fingerprint", "release_version", "os", "python", "node", "npm"],
      "properties": {
        "repo_root": { "type": "string" }, "framework_root": { "type": "string" }, "workspace_root": { "type": "string" },
        "git_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "git_branch": { "type": "string" }, "git_dirty": { "type": "boolean" },
        "worktree_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "release_version": { "type": "string" },
        "os": { "type": "object" }, "python": { "type": "string" }, "node": { "type": "string" }, "npm": { "type": "string" }
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false, "required": ["result", "checks"],
      "properties": { "result": { "enum": ["PASS", "FAIL", "BLOCKED"] }, "checks": { "type": "array", "items": { "$ref": "#/$defs/preflight_check" } } }
    },
    "preflight_check": {
      "type": "object", "additionalProperties": false, "required": ["check_id", "result", "reason"],
      "properties": { "check_id": { "type": "string" }, "result": { "enum": ["PASS", "FAIL", "BLOCKED"] }, "reason": { "type": "string" } }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "layer", "required", "claim", "command", "started_at", "finished_at", "duration_ms", "exit_code", "result", "reason", "evidence", "evidence_valid"],
      "properties": {
        "check_id": { "type": "string" }, "layer": { "enum": ["kernel", "backend", "frontend", "workspace", "integrations", "electron", "packaging", "e2e"] },
        "required": { "type": "boolean" }, "claim": { "type": "string" }, "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "started_at": { "type": "string", "format": "date-time" }, "finished_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 }, "exit_code": { "type": ["integer", "null"] },
        "result": { "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "NOT_RUN"] }, "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "evidence_valid": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "result": { "const": "PASS" } }, "required": ["result"] }, "then": { "properties": { "evidence_valid": { "const": true }, "evidence": { "minItems": 1 } }, "required": ["evidence_valid", "evidence"] } }
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "candidate_sha"],
      "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "artifact": { "$ref": "#/$defs/evidence" },
    "totals": {
      "type": "object", "additionalProperties": false, "required": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "NOT_RUN"],
      "properties": { "PASS": { "type": "integer", "minimum": 0 }, "FAIL": { "type": "integer", "minimum": 0 }, "BLOCKED": { "type": "integer", "minimum": 0 }, "SKIPPED": { "type": "integer", "minimum": 0 }, "NOT_RUN": { "type": "integer", "minimum": 0 } }
    }
  }
}
