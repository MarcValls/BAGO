        "bago-local": {
          "wire_name": "marcvallssanvictor/BAGO",
          "best_for": "boot phrases, project summary, session continuity, BAGO-style responses, local reasoning, reactor low-cost observe loop",
          "not_for": "unverified code writes, dangerous autonomous mutations, final validation",
          "cost": "free",
          "privacy": "local",
          "risk": "medium",
          "locality": 1.0,
          "role": "bago_native_model",
          "requires": [
            "ollama",
            "ollama pull marcvallssanvictor/BAGO"
          ]
        }
      }
    },
