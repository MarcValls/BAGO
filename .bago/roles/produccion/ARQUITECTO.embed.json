{
  "schema_version": "1.0.0",
  "role_id": "role_production_architect",
  "role_family": "production",
  "version": "3.4.2",
  "spiral_rules": {
    "min_cycle": 1,
    "max_cycle": null,
    "radius_thresholds": {
      "1.0": "base_identity + purpose",
      "1.5": "+ context_expansion + architecture_patterns",
      "2.0": "+ specialization + deep_snippets + governance_decisions"
    }
  },
  "artifacts": [
    {
      "ref": "prompt:spiral/base_identity",
      "priority": 1,
      "layer": "identity",
      "condition": "cycle >= 1",
      "inject_at": "head"
    },
    {
      "ref": "description:architecture/patterns",
      "priority": 2,
      "layer": "context",
      "condition": "cycle >= 1 and task_type in ('architecture','design','execution')",
      "inject_at": "body"
    },
    {
      "ref": "prompt:spiral/context_expansion",
      "priority": 2,
      "layer": "context",
      "condition": "cycle >= 2",
      "inject_at": "body"
    },
    {
      "ref": "snippet:python/error_handling",
      "priority": 3,
      "layer": "specialization",
      "condition": "cycle >= 3 or radius >= 2.0",
      "inject_at": "body"
    },
    {
      "ref": "snippet:python/registry_lookup",
      "priority": 3,
      "layer": "specialization",
      "condition": "cycle >= 3 or radius >= 2.0",
      "inject_at": "body"
    },
    {
      "ref": "prompt:spiral/specialization",
      "priority": 3,
      "layer": "specialization",
      "condition": "cycle >= 3 or radius >= 2.0",
      "inject_at": "tail"
    },
    {
      "ref": "description:governance/decision_log",
      "priority": 3,
      "layer": "specialization",
      "condition": "cycle >= 3 and task_type in ('architecture','governance')",
      "inject_at": "body"
    },
    {
      "ref": "command:shell/encoding_guard",
      "priority": 1,
      "layer": "identity",
      "condition": "cycle >= 1",
      "inject_at": "commands",
      "format": "inline_shell"
    }
  ],
  "prompt_template": {
    "head": "[IDENTIDAD]\n{base_identity}\n\n[PROPOSITO]\n{role_purpose}\n",
    "body": "\n[ARTEFACTOS DE CONTEXTO]\n{context_artifacts}\n\n[SNIPPETS Y COMANDOS]\n{specialized_artifacts}\n",
    "tail": "\n[INSTRUCCIONES ESPIRAL]\nEste es el ciclo {cycle} con radio {radius}.\nConstruye la solucion acumulativamente. No invalides decisiones de ciclos anteriores a menos que haya nueva evidencia.\nSi detectas un gate KO, detente y reporta.\n"
  },
  "dynamic_bindings": {
    "role_purpose": "Diseñar la estructura de la solucion, sus componentes, contratos, rutas y trade-offs.",
    "role_constraints": [
      "no reemplaza el analisis si falta comprension del contexto",
      "no valida en solitario"
    ]
  },
  "behaviors": {
    "drift_patterns": [
      "generic",
      "unclear",
      "contradiction"
    ],
    "force_include": [],
    "force_exclude": [],
    "strategy": "greedy",
    "ordering": "priority"
  }
}