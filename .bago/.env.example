# BAGO Framework — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env with real secrets.
#
# BAGO uses ~191 environment variables across tools. This file documents
# the most critical ones. For the full list, run:
#   grep -rE 'os\.environ\.get|os\.getenv|\$env:' .bago/tools/ .bago/core/

# ── Telegram (varios tools usan estas variables) ─────────────
# Bot token desde @BotFather
BAGO_TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
# Chat ID(s) para notificaciones (separados por coma si son varios)
BAGO_TELEGRAM_CHAT=1234567890
# Lista de chat IDs permitidos para el daemon (ej: 123,456)
BAGO_TELEGRAM_ALLOWED_CHAT_IDS=

# ── GitHub (releases, issues, API de Copilot) ───────────────
# Token personal de GitHub (scope: repo, workflow)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alias alternativo usado en algunos tools
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Token para GitHub Models (si usas modelos de GitHub)
# GITHUB_MODELS_TOKEN=ghm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI / Codex ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Ollama (local y cloud) ───────────────────────────────────
# Host local de Ollama (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
# API key para Ollama Cloud (si usas la versión cloud)
# OLLAMA_CLOUD_API_KEY=ollama-cloud-key-here
# OLLAMA_CLOUD_BASE_URL=https://api.ollama.com/v1

# ── Otros proveedores LLM ───────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Rutas principales de BAGO ───────────────────────────────
# Raíz del framework (si no coincide con C:\bago_true)
# BAGO_ROOT=C:\bago_true
# Directorio de trabajo del usuario
# BAGO_USER_CWD=C:\bago_true
# Directorio home del usuario (usado por logs/estado)
# BAGO_USER_HOME=C:\Users\YourUser
# Directorio de estado persistente
# BAGO_STATE_DIR=C:\bago_true\.bago\state

# ── Componentes opcionales ──────────────────────────────────
# Ruta al PADRE (núcleo semilla/instancia padre)
# BAGO_PADRE_PATH=C:\bago_true\.bago\core\padre
# Directorio de conocimiento (override)
# BAGO_KNOWLEDGE_ROOT=C:\bago_true\.bago\knowledge
# Directorio de motores (override)
# BAGO_MOTOR_ROOT=C:\bago_true\.bago\motors
# Configuración de Music SaaS
# BAGO_MUSIC_SAAS_DIR=C:\bago_true\.bago\music_saas
# BAGO_MUSIC_URL=https://your-music-instance.com

# ── API y servicios internos ────────────────────────────────
# Timeout para llamadas a API interna (segundos)
# BAGO_API_TIMEOUT=30
# Host del miniapp server
# BAGO_MINIAPP_HOST=0.0.0.0
# Token de auth para miniapp server
# BAGO_MINIAPP_TOKEN=your-miniapp-secret
# URL base de send.now
# BAGO_SEND_API_BASE_URL=https://api.send.now
# URL pública de send.now
# BAGO_SEND_PUBLIC_BASE_URL=https://send.now
# API key de send.now / sendcm
# SENDNOW_API_KEY=sn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDCM_API_KEY=cm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Neural bus / gateway ────────────────────────────────────
# Puerto del neural bus
# BAGO_NEURAL_PORT=9876
# URL del neural bus
# BAGO_NEURAL_URL=http://localhost:9876
# Directorio de estado neural
# BAGO_NEURAL_STATE_DIR=C:\bago_true\.bago\state\neural

# ── Cloud / Gateway ─────────────────────────────────────────
# URL del gateway cloud
# BAGO_CLOUD_URL=https://cloud.bago.example
# API key del gateway cloud
# BAGO_CLOUD_API_KEY=cloud-api-key-here

# ── Configuración de issues / sync ──────────────────────────
# Repo para reportar issues (formato: owner/repo)
# BAGO_ISSUES_REPO=MarcValls/BAGO
# Label por defecto para issues
# BAGO_ISSUES_LABEL=bug
# Repo para sincronización de conocimiento
# BAGO_KNOWLEDGE_REPO=MarcValls/BAGO

# ── Desactivación de componentes ────────────────────────────
# Para desactivar wizard en CI
# BAGO_SKIP_WIZARD=1
# Para desactivar rubber-duck en CI
# BAGO_SKIP_RD=1
# Para desactivar SAC (Semantic Action Controller)
# BAGO_NO_SAC=1
# Para desactivar prompt_toolkit y usar input() simple
# BAGO_NO_PROMPT_TOOLKIT=1
# Para desactivar litellm y usar llamadas directas
# BAGO_NO_LITELLM=1

# ── Seguridad / depuración ──────────────────────────────────
# Mostrar rastros de sesión en truth gate
# BAGO_TRACE_SESSION=1
# Desactivar proveedores deshabilitados en health checks
# BAGO_SHOW_DISABLED_PROVIDERS=1
# Modo MCP (simple|full)
# BAGO_MCP_MODE=simple
# Permitir operaciones mutantes en MCP
# BAGO_ALLOW_MUTATING=0
# Permitir operaciones peligrosas en MCP
# BAGO_ALLOW_DANGEROUS=0
# Máximo de caracteres de salida MCP
# BAGO_MCP_MAX_OUTPUT_CHARS=10000

# ── Otras variables estándar que BAGO consulta ───────────────
# PATH, HOME, USERPROFILE, LOCALAPPDATA, APPDATA, TEMP,
# COLORTERM, TERM, NO_COLOR, CI, EDITOR, SHELL, COMPUTERNAME

# ── Red / Hardware (Lenovo Ethernet, descubrimiento, peers) ──
# IP propia del adaptador Ethernet (APIPA / link-local).  Usada por
# http_discover.py y lenovo_connect.py para omitirse a sí mismos.
# BAGO_OWN_ETHERNET_IP=169.254.31.155

# Nombre de la interfaz Ethernet en Windows.  Usado por net_interact.py.
# BAGO_ETHERNET_IFACE=Ethernet

# IP local APIPA del adaptador Ethernet.  Usada por net_interact.py.
# BAGO_LOCAL_APIPA_IP=169.254.31.155

# IP temporal añadida para acceder a la red interna.  Usada por net_interact.py.
# BAGO_TEMP_IP=10.0.0.250

# IPs temporales extra a eliminar en cleanup (separadas por coma).
# BAGO_EXTRA_TEMP_IPS=192.168.0.250,192.168.1.250,172.16.0.250

# DNS público de fallback para detectar ruta local.  Usado por peer_link.py.
# BAGO_FALLBACK_DNS=8.8.8.8
